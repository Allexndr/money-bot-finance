// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("dengi_MONGODB_URI")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  telegram_id  Int      @unique
  username     String?
  first_name   String?
  last_name    String?
  created_at   DateTime @default(now())
  is_subscribed Boolean  @default(true)

  @@map("users")
}

model CourseApplication {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id          String
  user_telegram_id Int
  username         String?
  first_name       String?
  status           String   @default("pending")
  created_at       DateTime @default(now())
  processed_at     DateTime?
  processed_by     String?

  @@map("course_applications")
}

model Newsletter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String
  created_at DateTime @default(now())
  sent_at   DateTime?
  is_sent   Boolean  @default(false)

  @@map("newsletters")
}

model BotMessage {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  page_key    String      @unique
  title       String?
  text        String
  parse_mode  String      @default("HTML")
  is_main_menu Boolean     @default(false)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  buttons     BotButton[]

  @@map("bot_messages")
}

model BotButton {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  message_id  String      @db.ObjectId
  text        String
  button_type String
  action_data String
  row         Int         @default(0)
  order       Int         @default(0)
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  message     BotMessage  @relation(fields: [message_id], references: [id])

  @@map("bot_buttons")
}

model BotState {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  telegram_id  Int      @unique
  action       String   // e.g. "admin_create_button"
  step         String   // e.g. "type_selection"
  data         String   // JSON string
  updated_at   DateTime @updatedAt

  @@map("bot_states")
}
